<odoo>

    <record model="ir.actions.client" id="indicator">
            <field name="name">New Indicator</field>
            <field name="tag">cuadro_de_mando.NewIndicatorDialog</field>
            <field name="target">current</field>
            <field name="params" eval="{'current_record': '@self', 'test_param': 'test'}"/>
    </record>

    <record id="view_dashboard_indicator_form" model="ir.ui.view">
        <field name="name">dashboard.indicator.form</field>
        <field name="model">dashboard.indicator</field>
        <field name="arch" type="xml">
            <form string="Dashboard Indicator" create="false">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="model" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dashboard_indicator_tree" model="ir.ui.view">
        <field name="name">dashboard.indicator.tree</field>
        <field name="model">dashboard.indicator</field>
        <field name="arch" type="xml">
            <tree string="Dashboard Indicators" create="false">
                <field name="name"/>
                <button name="cuadro_de_mando.indicator" string="Crear nuevo indicador" type="action"></button>
            </tree>
        </field>
    </record>

    <record id="action_dashboard_indicator" model="ir.actions.act_window">
        <field name="name">Dashboard Indicators</field>
        <field name="res_model">dashboard.indicator</field>
        <field name="view_mode">tree,form</field>
    </record>


</odoo>

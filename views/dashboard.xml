<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.actions.client" id="dashboard">
            <field name="name">Dashboard</field>
            <field name="tag">cuadro_de_mando.owl_dashboard</field>
            <field name="target">current</field>
            <field name="params" eval="{'current_record': '@self', 'test_param': 'test'}"/>
        </record>
        
        <record id="view_dashboard_tree" model="ir.ui.view">
            <field name="name">dashboard.dashboard.tree</field>
            <field name="model">dashboard.dashboard</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <button name="cuadro_de_mando.dashboard" string="Abrir tablero" type="action"/>
                </tree>
            </field>
        </record>

        <record id="view_dashboard_form" model="ir.ui.view">
            <field name="name">dashboard.dashboard.form</field>
            <field name="model">dashboard.dashboard</field>
            <field name="arch" type="xml">
                <form string="Dashboard">
                    <group>
                        <field name="name" widget="char" placeholder="Enter theme name"/>
                        <field name="indicator_ids" options="{'no_create': True, 'create': False}" />
                    </group>
                    <group>
                        <button name="cuadro_de_mando.dashboard" string="Ir al Dashboard" type="action"/>
                    </group>
                </form>
            </field>
        </record>



        <record id="action_dashboard" model="ir.actions.act_window">
            <field name="name">Dashboards</field>
            <field name="res_model">dashboard.dashboard</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="cuadro_de_mando.NewIndicatorDialog">
        <div class="container h-100 overflow-auto p-2">
            <h3 class="mb-3">Configure your new Indicator</h3>
            <ul class="nav nav-tabs" id="myTab" role="tablist">
                <li class="nav-item" role="presentation">
                <button class="nav-link active" id="single-tab" data-bs-toggle="tab" data-bs-target="#single-tab-pane"
                        type="button" role="tab" aria-controls="single-tab-pane"
                        aria-selected="true">Single query</button>
                </li>
                <li class="nav-item" role="presentation">
                <button class="nav-link" id="group-tab" data-bs-toggle="tab" data-bs-target="#group-tab-pane"
                        type="button" role="tab" aria-controls="group-tab-pane"
                        aria-selected="false">Group query</button>
                </li>
            </ul>
            <div class="tab-content" id="myTabContent">
                <div class="tab-pane fade show active" id="single-tab-pane" role="tabpanel" aria-labelledby="single-tab"
                     tabindex="0">
                    <div class="row p-3"><h1>Single</h1></div>
                    <div class="row p-3">
                        <div class="col p-2">
                            <label class="form-label" for="name_input">Indicator name:</label>
                            <div class="input-group mb-3">
                                <input type="text" class="form-control" aria-label="Name input" aria-describedby="nameInputGroup" placeholder="Name" t-model="state.indicatorName"/>
                            </div>
                        </div>
                    </div>
                    <div class="row p-3">
                        <div class="col p-2">
                            <label class="form-label" for="module_selector">Module to retrieve data:</label>
                            <select id="module_selector" t-model="state.selectedModule" t-on-change="fetchModels"
                                    class="form-select">
                                <option value="" selected="true">Select a module</option>
                                <t t-foreach="modules" t-as="module" t-key="module.name">
                                    <option t-att-value="module.name" t-esc="module.desc"></option>
                                </t>
                            </select>
                        </div>
                        <div class="col p-2">
                            <label class="form-label" for="model_selector">Model:</label>
                            <select id="model_selector" t-if="state.moduleIsSelected" t-model="state.selectedModel"
                                    t-on-change="fetchModelFields" class="form-select">
                                <option value="" selected="true">Select a model</option>
                                <t t-foreach="models" t-as="model" t-key="model.model">
                                    <option t-att-value="model.model" t-esc="model.model_name"></option>
                                </t>
                            </select>
                        </div>
                    </div>
                    <div class="row p-3">
                        <div class="col p-2">
                            <label class="form-label" for="data_field_selector">Data:</label>
                            <select id="data_field_selector" t-if="state.modelIsSelected" t-model="state.selectedField"
                                    class="form-select">
                                <option value="" selected="true">Select a field</option>
                                <t t-foreach="Object.values(fields)" t-as="field" t-key="field.name">
                                    <option t-att-value="field.name"
                                            t-if="['integer', 'char', 'monetary', 'float', 'text', 'boolean'].includes(field.type)"
                                            t-esc="`${field.string} - Tipo: ${field.type}`"></option>
                                </t>
                            </select>
                        </div>
                        <div class="col p-2">
                            <label class="form-label" for="label_selector">Graph labels:</label>
                            <select id="label_selector" t-if="state.modelIsSelected" t-model="state.labelsField"
                                    class="form-select">
                                <option value="" selected="true">Select fields to act as labels</option>
                                <t t-foreach="Object.values(fields)" t-as="field" t-key="field.name">
                                    <option t-if="['integer', 'char', 'float', 'text', 'boolean'].includes(field.type)"
                                            t-att-value="field.name"
                                            t-esc="`${field.string} - Tipo: ${field.type}`"></option>
                                </t>
                            </select>
                        </div>
                    </div>
                    <div class="row p-3">
                        <div class="col p-2">
                            <label class="form-label" for="order_by_field_selector">Order by:</label>
                            <select id="order_by_field_selector" t-if="state.modelIsSelected"
                                    t-model="state.orderByField" class="form-select">
                                <option value="" selected="true">Select the field to order by</option>
                                <t t-foreach="Object.values(fields)" t-as="field" t-key="field.name">
                                    <option t-att-value="field.name"
                                            t-esc="`${field.string} - Tipo: ${field.type}`" t-if="field.sortable"></option>
                                </t>
                            </select>
                        </div>
                        <div t-if="state.orderByField" class="col p-2">
                            <label class="form-label" for="order_by_field_selector">Order by:</label>
                            <div class="col p-2 mx-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="orderRadio" id="orderRadio-asc" checked="true" t-on-change="(ev) => this.changeOrder(ev, 'asc')"/>
                                    <label class="form-check-label" for="orderRadio-count">
                                        Ascendente
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="orderRadio" id="orderRadio-desc" t-on-change="(ev) => this.changeOrder(ev, 'desc')"/>
                                    <label class="form-check-label" for="orderRadio-avg">
                                        Descendente
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row p-3">
                        <div class="col p-2">
                            <label class="form-label" for="item_type_selector">Indicator type:</label>
                            <t t-set="item_types"
                               t-value="[{type: 'number', name: 'Number Card'}, {type: 'pie', name: 'Pie Chart'}, {type: 'bar', name: 'Bar Chart'}, {type: 'line', name: 'Line Chart'}]"/>
                            <select id="item_type_selector" t-model="state.dashboardItemType" class="form-select">
                                <option value="" selected="true">Select the type of indicator</option>
                                <t t-foreach="item_types" t-as="item" t-key="item.type">
                                    <option t-att-value="item.type" t-esc="item.name"></option>
                                </t>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade" id="group-tab-pane" role="tabpanel" aria-labelledby="group-tab" tabindex="0">
                    <div class="row p-3"><h1>Group</h1></div>
                    <div class="row p-3">
                        <div class="col p-2">
                            <label class="form-label" for="name_input">Indicator name:</label>
                            <div class="input-group mb-3">
                                <input type="text" class="form-control" aria-label="Name input" aria-describedby="nameInputGroup" placeholder="Name" t-model="state.indicatorName"/>
                            </div>
                        </div>
                    </div>
                    <div class="row p-3">
                        <div class="col p-2">
                            <label class="form-label" for="module_selector">Module to retrieve data:</label>
                            <select id="module_selector" t-model="state.selectedModule" t-on-change="fetchModels"
                                    class="form-select">
                                <option value="" selected="true">Select a module</option>
                                <t t-foreach="modules" t-as="module" t-key="module.name">
                                    <option t-att-value="module.name" t-esc="module.desc"></option>
                                </t>
                            </select>
                        </div>
                        <div class="col p-2">
                            <label class="form-label" for="model_selector">Model:</label>
                                <select id="model_selector" t-if="state.moduleIsSelected" t-model="state.selectedModel"
                                        t-on-change="fetchModelFields" class="form-select">
                                <option value="" selected="true">Select a model</option>
                                    <t t-foreach="models" t-as="model" t-key="model.model">
                                    <option t-att-value="model.model" t-esc="model.model_name"></option>
                                </t>
                            </select>
                        </div>
                        <div class="col p-2">
                            <label class="form-label" for="data_field_selector">Data:</label>
                            <select id="data_field_selector" t-if="state.modelIsSelected" t-model="state.selectedField"
                                    class="form-select">
                                    <option value="" selected="true">Select a field</option>
                                <t t-foreach="selectableFields" t-as="field" t-key="field.name">
                                        <option t-att-value="field.name"
                                                t-if="['integer', 'char', 'float', 'monetary', 'text', 'boolean'].includes(field.type)"
                                                t-esc="`${field.string} - Tipo: ${field.type}`"></option>
                                </t>
                            </select>
                        </div>
                    </div>
                    <div class="row p-3">
                        <label>Aggregation: </label>
                        <div class="col p-2 mx-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="aggRadio" id="aggRadio-count" checked="true" t-on-change="(ev) => this.changeAggregation(ev, 'count')"/>
                                <label class="form-check-label" for="aggRadio-count">
                                    Count
                                </label>
                            </div>
                        </div>
                        <div class="col p-2 mx-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="aggRadio" id="aggRadio-avg" t-on-change="(ev) => this.changeAggregation(ev, 'avg')"/>
                                <label class="form-check-label" for="aggRadio-avg">
                                    Average
                                </label>
                            </div>
                        </div>
                        <div class="col p-2 mx-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="aggRadio" id="aggRadio-sum" t-on-change="(ev) => this.changeAggregation(ev, 'sum')"/>
                                <label class="form-check-label" for="aggRadio-sum">
                                    Sum
                                </label>
                            </div>
                        </div>
                        <div class="col p-2 mx-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="aggRadio" id="aggRadio-max" t-on-change="(ev) => this.changeAggregation(ev, 'max')"/>
                                <label class="form-check-label" for="aggRadio-max">
                                    Max
                                </label>
                            </div>
                        </div>
                        <div class="col p-2 mx-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="aggRadio" id="aggRadio-min" t-on-change="(ev) => this.changeAggregation(ev, 'min')"/>
                                <label class="form-check-label" for="aggRadio-min">
                                    Min
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="row p-3">
                        <div class="col p-2">
                            <label class="form-label" for="order_by_field_selector">Order by:</label>
                            <div class="col p-2 mx-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="orderRadio" id="orderRadio-asc" checked="true" t-on-change="(ev) => this.changeOrder(ev, 'asc')"/>
                                    <label class="form-check-label" for="orderRadio-count">
                                        Ascendente
                                    </label>
                                </div>
                            </div>
                            <div class="col p-2 mx-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="orderRadio" id="orderRadio-desc" t-on-change="(ev) => this.changeOrder(ev, 'desc')"/>
                                    <label class="form-check-label" for="orderRadio-avg">
                                        Descendente
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row p-3">
                        <div class="col p-2">
                            <label class="form-label" for="grouped_fields_selector">Group by first:</label>
                            <select id="grouped_field_selector-1" t-if="state.modelIsSelected"
                                    t-on-change="onChangeGroups" class="form-select">
                                <option value="" selected="true">Select the 1st field to group by</option>
                                <t t-foreach="Object.values(fields)" t-as="field" t-key="field.name">
                                    <t t-if="['integer', 'char', 'float', 'text', 'boolean', 'many2one', 'many2many'].includes(field.type)">
                                        <t t-if="field.depends.length &lt; 2">
                                            <option t-att-value="field.name" t-esc="`${field.string} - Tipo: ${field.type}`"></option>
                                        </t>
                                    </t>
                                </t>
                            </select>
                        </div>
                        <div class="col p-2">
                            <label class="form-label" for="grouped_fields_selector">Group by second:</label>
                            <select id="grouped_field_selector-2" t-if="state.modelIsSelected"
                                    t-on-change="onChangeGroups" class="form-select">
                                <option value="" selected="true">Select the 2nd field to group by</option>
                                <t t-foreach="Object.values(fields)" t-as="field" t-key="field.name">
                                    <t t-if="['integer', 'selection', 'char', 'float', 'text', 'boolean', 'many2one', 'many2many'].includes(field.type)">
                                        <t t-if="field.depends.length &lt; 2">
                                            <option t-att-value="field.name" t-esc="`${field.string} - Tipo: ${field.type}`"></option>
                                        </t>
                                    </t>
                                </t>
                            </select>
                        </div>
                    </div>
                    <div class="row p-3">
                        <t t-foreach="state.groupingFields" t-as="field" t-key="field.name">
                            <div class="col p-2" t-if="field.data">
                                <label t-att-for="`${field.name}_selector`" class="form-label"><t t-esc="field.description"/>
                                    identifier</label>
                                <select t-att-id="`${field.name}_selector`" class="form-select"
                                        t-on-change="(event) => this.onChangeGroupsLabel(event, field.relation)">
                                    <option value="" selected="true">Select the field to represent <t
                                            t-esc="field.description"></t></option>
                                    <t t-foreach="field.data" t-as="relationField" t-key="relationField.name">
                                        <option t-if="relationField.type == 'char'" t-att-value="relationField.name"
                                                t-esc="`${relationField.string} - Tipo: ${relationField.type}`"></option>
                                    </t>
                                </select>
                            </div>
                        </t>
                    </div>
                    <div class="row p-3">
                        <div class="col p-2">
                            <label class="form-label" for="item_type_selector">Indicator type:</label>
                            <t t-set="item_types"
                               t-value="[{type: 'number', name: 'Number Card'}, {type: 'pie', name: 'Pie Chart'}, {type: 'bar', name: 'Bar Chart'}, {type: 'line', name: 'Line Chart'}]"/>
                            <select id="item_type_selector" t-model="state.dashboardItemType" class="form-select">
                                <option value="" selected="true">Select the type of indicator</option>
                                <t t-foreach="item_types" t-as="item" t-key="item.type">
                                    <option t-att-value="item.type" t-esc="item.name"></option>
                                </t>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <button class="btn btn-primary" t-on-click="fetchTheDataTest" t-esc="addButtonText"/>
            </div>
        </div>
    </t>
</templates>

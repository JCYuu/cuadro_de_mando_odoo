<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="cuadro_de_mando.IndicatorDashboard">
        <Layout display="display" className="'o_dashboard overflow-auto h-100 container-fluid'">
            <t t-set-slot="layout-buttons"> 
                <h2 class="my-auto pe-3" t-esc="dashboardName"/>               
                <button class="btn btn-primary me-3" t-on-click="openNewItem">New item</button>
            </t>
            <t t-set-slot="control-panel-additional-actions">
                <button t-on-click="openDashboardConfig" class="btn p-0 ms-1 border-0">
                    <i class="fa fa-cog"></i>
                </button>
            </t>

            <div class="d-flex flex-wrap" t-if="statistics.isReady">
                <t t-foreach="items" t-as="item" t-key="item.id">
                    <div class="col-auto">
                        <DashboardItem t-if="!state.disabledItems.includes(item.id)" size="item.size || 1">
                            <t t-set="itemProp" t-value="item.props ? item.props(statistics) : {'data': statistics}"/>
                            <t t-component="item.Component" t-props="itemProp"/>
                        </DashboardItem>
                    </div>
                </t>
                <t t-foreach="addedItems" t-as="item" t-key="item.id">
                    <div class="col-auto">
                        <DashboardItem size="item.size || 1">
                            <t t-set="itemProp" t-value="item.props ? item.props : {'data': statistics}"/>
                            <t t-component="item.Component" t-props="itemProp"/>
                        </DashboardItem>
                    </div>
                </t>
            </div>
        </Layout>    
    </t>

    <t t-name="cuadro_de_mando.ConfigurationDialog">
        <Dialog title="'Dashboard items configuration'">
            Which cards do you wish to see ?
            <t t-foreach="items" t-as="item" t-key="item.id">
                <CheckBox value="item.enabled" onChange="(ev) => this.onChange(ev, item)">
                    <t t-esc="item.description"/>
                </CheckBox>
            </t>
            <select class="form-select">
                <option selected="true">Select a module</option>
                <t t-foreach="modules" t-as="module" t-key="module.name">
                    <option t-att-value="module.name" t-esc="module.desc"></option>
                </t>
            </select>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="done">
                    Done
                </button>
            </t>


        </Dialog>
    </t>

    <t t-name="cuadro_de_mando.NewItemDialog">
        <Dialog title="'New Indicator'">
            <NewIndicatorDialog close="props.close" updateItems="props.updateItems" dashboardId="props.dashboardId"/>
            <t t-set-slot="footer">
                <button class="btn btn-primary d-none"/>
            </t>
        </Dialog>
    </t>
</templates>
